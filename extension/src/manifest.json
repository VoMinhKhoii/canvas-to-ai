{
  "manifest_version": 3,
  "name": "Canvas to AI",
  "description": "Pick a week of your Canvas course and copy it for ChatGPT, Claude or Gemini: slides, PDFs, docs, sheets and code, read on your own computer.",
  "permissions": [
    "sidePanel",
    "scripting",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas-user-content.com/*",
    "https://*.inscloudgate.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Canvas to AI"
  }
}
